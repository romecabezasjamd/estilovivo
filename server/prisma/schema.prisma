// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  password           String
  name               String
  avatar             String?
  fullBodyAvatar     String?
  bio                String?
  mood               String?
  cycleTracking      Boolean    @default(false)
  musicSync          Boolean    @default(false)
  emailNotifications Boolean    @default(true)
  emailChat          Boolean    @default(true)
  emailFollows       Boolean    @default(true)
  emailWashing       Boolean    @default(true)
  emailChallenges    Boolean    @default(true)
  gender             String?    @default("other")
  birthDate         DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  isVerified        Boolean    @default(false)
  verificationToken String?
  experiencePoints  Int        @default(0)
  level             Int        @default(1)
  themePreset       String?
  customColor       String?
  isProfilePublic   Boolean    @default(true)
  styleColors       String?
  styleStyles       String?
  styleOccasions    String?
  styleFabrics      String?
  locationName      String?
  darkModeSetting   String?    @default("off")
  fontSize          String?    @default("normal")
  highContrast      Boolean    @default(false)
  suspendedAt       DateTime?  // moderación: cuenta suspendida (no puede entrar ni usar la API)
  sellerDeclaredAt  DateTime?  // compraventa: declaró vender como particular (no profesional)
  language          String?    @default("es")
  dialect           String?    @default("none")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  @@index([resetToken])
  @@index([verificationToken])
  
  products          Product[]
  looks             Look[]
  plannerEntries    PlannerEntry[]
  trips             Trip[]
  likes             Like[]
  comments          Comment[]
  favorites         Favorite[]
  followers         Follow[]   @relation("following")
  following         Follow[]   @relation("follower")
  sentFollowRequests     FollowRequest[] @relation("requester")
  receivedFollowRequests FollowRequest[] @relation("target")
  chatParticipants  ConversationParticipant[]
  messages          Message[]
  notifications     Notification[]
  stories           Story[]
  challengeSubmissions ChallengeSubmission[]
  achievements        UserAchievement[]
  badges              UserBadge[]
  streak              UserStreak?
  tryonPresets        TryonPreset[]
  refreshTokens       RefreshToken[]
  blocksMade          Block[]    @relation("blocker")
  blocksReceived      Block[]    @relation("blocked")
  pushTokens          PushToken[]
  guardianOf          GuardianLink[] @relation("guardian")
  guardianLink        GuardianLink?  @relation("minor")
}

// Moderación (aditivo): bloqueos entre usuarios y denuncias de contenido
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// reporterId/targetId son ids simples (sin FK) para conservar la denuncia aunque se borre el contenido o la cuenta
model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String   // USER | LOOK | COMMENT | STORY | MESSAGE
  targetId   String
  reason     String   // SPAM | HARASSMENT | INAPPROPRIATE | IMPERSONATION | OTHER
  details    String?
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@index([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

model TryonPreset {
  id          String   @id @default(cuid())
  name        String
  thumbnail   String?
  layers      String   @default("[]") // JSON string of layer data
  rating      Int?
  occasion    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Product {
  id          String     @id @default(cuid())
  name        String
  description String?
  price       Float?
  brand       String?
  category    String
  size        String?
  color       String?
  condition   String     @default("new")
  season      String     @default("all")
  usageCount  Int        @default(0)
  lastWorn    DateTime?
  forSale     Boolean    @default(false)
  isWashing   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  images      ProductImage[]
  looks       Look[]
  favorites   Favorite[]
  tripGarments TripGarment[]
  
  @@index([userId, createdAt])
  @@index([forSale, category])
  @@index([userId, category])
}

model ProductImage {
  id        String     @id @default(cuid())
  url       String
  filename  String
  createdAt DateTime   @default(now())
  
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Look {
  id          String     @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean    @default(false)
  mood        String?
  tags        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  products    Product[]
  images      LookImage[]
  plannerEntries PlannerEntry[]
  likes       Like[]
  comments    Comment[]
  favorites   Favorite[]
  
  @@index([isPublic, createdAt])
  @@index([userId, createdAt])
}

model LookImage {
  id        String     @id @default(cuid())
  url       String
  filename  String
  createdAt DateTime   @default(now())
  
  lookId    String
  look      Look       @relation(fields: [lookId], references: [id], onDelete: Cascade)
}

model PlannerEntry {
  id        String   @id @default(cuid())
  date      String   // ISO date string YYYY-MM-DD
  lookId    String?
  look      Look?    @relation(fields: [lookId], references: [id])
  eventNote String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Trip {
  id          String        @id @default(cuid())
  destination String
  dateStart   String
  dateEnd     String
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       TripItem[]
  garments    TripGarment[]

  @@index([userId])
}

model TripItem {
  id          String  @id @default(cuid())
  label       String
  checked     Boolean @default(false)
  isEssential Boolean @default(false)
  tripId      String
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model TripGarment {
  id        String  @id @default(cuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tripId, productId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookId    String
  look      Look     @relation(fields: [lookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lookId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookId    String
  look      Look      @relation(fields: [lookId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
  
  @@index([lookId, createdAt])
  @@index([parentId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookId    String?
  look      Look?    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lookId])
  @@unique([userId, productId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

model FollowRequest {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  targetId    String
  target      User     @relation("target", fields: [targetId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())

  @@unique([requesterId, targetId])
}

model Conversation {
  id            String                     @id @default(cuid())
  itemId        String?
  itemTitle     String?
  itemImage     String?
  itemOwnerId   String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  imageUrl       String?
  productId      String?
  // Reacciones a historias (aditivo, nullable): referencia a la historia y copia de su imagen
  storyId        String?
  storyThumb     String?
  createdAt      DateTime      @default(now())
  
  @@index([conversationId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // e.g. "SALE", "CHAT", "WASHING", "INTEREST"
  content   String?
  relatedId String?  // p. ej. conversationId para CHAT
  isRead    Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "image" | "text"
  text      String?
  imageUrl  String?
  views     Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model WeeklyChallenge {
  id          String   @id @default(cuid())
  title       String
  description String
  reward      Int      @default(50)
  tag         String
  startDate   DateTime @default(now())
  endDate     DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  submissions ChallengeSubmission[]
  @@index([active])
  @@index([startDate, endDate])
}

model ChallengeSubmission {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  imageUrl    String?
  description String?
  verified    Boolean  @default(false)
  awarded     Boolean  @default(false)
  // Estado de la validación: VALID | INVALID | PENDING (aditivo, por defecto PENDING)
  status      String   @default("PENDING")
  reason      String?
  // Huella de la foto (para no aceptar la misma foto dos veces en los retos)
  imageHash   String?
  createdAt   DateTime @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge WeeklyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId])
  @@index([userId])
}

model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  achievementKey String
  title          String
  description    String
  icon           String
  xpReward       Int      @default(0)
  unlockedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementKey])
  @@index([userId])
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeKey    String
  title       String
  description String
  icon        String
  unlockedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
}

model UserStreak {
  id         String    @id @default(cuid())
  userId     String    @unique
  loginCount Int       @default(0)
  lastDate   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Dispositivos que reciben push (FCM). Un token pertenece a una sola cuenta: si otra inicia sesión en el mismo
// móvil, el token se reasigna.
model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  platform  String   @default("android")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Adulto responsable de una persona menor (14-17): autoriza la compraventa. Un menor tiene como mucho uno.
model GuardianLink {
  id                 String   @id @default(cuid())
  minorId            String   @unique
  minor              User     @relation("minor", fields: [minorId], references: [id], onDelete: Cascade)
  guardianId         String
  guardian           User     @relation("guardian", fields: [guardianId], references: [id], onDelete: Cascade)
  status             String   @default("PENDING") // PENDING | APPROVED
  marketplaceAllowed Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([guardianId])
}

// ============= PANEL DE ADMINISTRACIÓN =============
// Registro de cada acción del panel (quién, qué y cuándo). Se conserva 3 años.
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String   // id simple (sin FK) para conservar el registro
  action     String   // p. ej. REPORT_REMOVE, USER_SUSPEND, PRODUCT_REMOVE, BROADCAST...
  targetType String?
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Subidas bloqueadas por el detector de fotos íntimas. NUNCA se guarda la foto, solo estos datos (90 días).
model BlockedUpload {
  id        String   @id @default(cuid())
  userId    String?
  route     String
  score     Float
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// Cierres de la app y errores de la web, para poder arreglarlos (90 días).
model CrashReport {
  id        String   @id @default(cuid())
  signature String   // huella de las primeras líneas, para agrupar el mismo fallo
  title     String
  source    String   // app | web
  version   String?
  device    String?
  userId    String?
  trace     String
  createdAt DateTime @default(now())

  @@index([signature, createdAt])
  @@index([createdAt])
}

// Solicitudes de derechos de privacidad (RGPD arts. 15-22): plazo de respuesta de un mes.
model PrivacyRequest {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  name       String?
  type       String    // ACCESS | RECTIFY | DELETE | OBJECT | RESTRICT | PORTABILITY | OTHER
  message    String
  status     String    @default("OPEN") // OPEN | DONE | REJECTED
  response   String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
}
